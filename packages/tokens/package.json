{
  "name": "@kit/tokens",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "The kit's design tokens: one set of --k-* CSS variables for light, dark and brand themes, plus generated bridges for Tailwind v4 and shadcn/ui, and tokens.json. No dependencies.",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./css/tokens.css",
    "./tailwind.css": "./css/tailwind.css",
    "./to-shadcn.css": "./css/to-shadcn.css",
    "./from-shadcn.css": "./css/from-shadcn.css",
    "./tokens.json": "./tokens.json"
  },
  "engines": { "node": ">=22.23.4" },
  "scripts": { "build": "node src/write.ts", "test": "node --test test/*.test.ts", "typecheck": "tsc -p ." },
  "devDependencies": { "@types/node": "22.20.5", "typescript": "5.9.3" }
}
