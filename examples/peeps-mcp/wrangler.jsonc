// The PeepCraft MCP Worker. Build first (npm run build:mcp); wrangler uploads dist/worker.js as it is (no_bundle), the file the budget checked.
{
  "name": "peepcraft-mcp",
  "main": "dist/worker.js",
  "no_bundle": true,
  "compatibility_date": "2026-09-01",
  "routes": [{ "pattern": "peepcraft-mcp.jinnux.com", "custom_domain": true }],
  // Also on workers.dev: outside the jinnux.com zone, so its bot protection (a challenge MCP clients cannot pass) does not apply there.
  "workers_dev": true,
  // SERVER_PHOTOS is not set, so photos are not read on this server's key; "on" (with the ANTHROPIC_API_KEY secret) turns it back on.
  // PHOTO_ORIGINS: the pages whose From photo button may call POST /photo (each photo is paid for with this server's key).
  "vars": { "PEEPCRAFT_URL": "https://peepcraft.jinnux.com/", "ALLOWED_ORIGINS": "*", "PHOTO_ORIGINS": "https://peepcraft.jinnux.com", "PHOTO_DAILY_LIMIT": "50" },
  // 60 requests a minute per client address; a render is the costly call.
  // PHOTO_LIMITER: 5 photos a minute per client address for from_image, each a paid model call. The model reads its key from the
  // ANTHROPIC_API_KEY secret (npx wrangler secret put ANTHROPIC_API_KEY); PERCEIVE_MODEL in "vars" picks another model.
  "ratelimits": [
    { "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    { "name": "PHOTO_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }
  ],
  // PHOTO_CAP: the daily cap on photos for the whole server (PHOTO_DAILY_LIMIT in "vars", a UTC day); without it photos are off.
  "durable_objects": { "bindings": [{ "name": "PHOTO_CAP", "class_name": "PhotoCap" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PhotoCap"] }],
  // Run in the US, not next to the visitor: a Worker calls out from where it runs, and the Anthropic API refuses some regions (a visitor in
  // Vietnam was served from Hong Kong, and the API answered 403 "Request not allowed").
  "placement": { "region": "aws:us-east-1" },
  "observability": { "enabled": true }
}
